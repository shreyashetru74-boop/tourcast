# Copy this file to .env and fill in your own values. Never commit .env.

# Qloo hackathon key (leave empty to run with demo data)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible LLM. Defaults to Google Gemini (free tier available).
# Leave LLM_API_KEY empty to run the planner without an LLM.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
